# ---------------------------------------------------------------------------
# PhishGuard-Multimodal — generic env template.
#
# Prefer the per-environment templates:
#   .env.local.example            (Local compose stack with all dependencies)
#   deploy/env/.env.dev-1.example (Dokploy dev-1 branch)
#   deploy/env/.env.dev-2.example (Dokploy dev-2 branch)
#   deploy/env/.env.prod.example  (Dokploy prod / main branch)
#
# Copy one to `.env` (gitignored) or paste into Dokploy's Environment editor.
# For local all-in-one stack: `docker compose -f docker-compose.local.yml up -d`
# For Dokploy: Dokploy-managed datastores run on `dokploy-network`.
# ---------------------------------------------------------------------------

ENV_NAME=dev-1
COMPOSE_PROJECT_NAME=phishguard-dev-1
GATEWAY_PORT=8010

ENVIRONMENT=development
AUTH_DEV_MODE=true
STATIC_DIR=/app/apps/backend/static

# Bare `postgresql://` (NOT +psycopg); db/database.py rewrites it to +asyncpg.
DATABASE_URL=postgresql://phishguard:CHANGE_ME_PG@phishguard-db-dev-1-vpr6fe:5432/phishguard
REDIS_URL=redis://:CHANGE_ME_REDIS@phishguard-redis-dev-1-tn0mlf:6379/0

# --- Artifact Storage (RustFS S3-compatible, external host) -----------------
RUSTFS_ENDPOINT_URL=http://rustfs:9000
RUSTFS_ACCESS_KEY=CHANGE_ME_RUSTFS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET
RUSTFS_BUCKET=phishguard-artifacts
RUSTFS_REGION=us-east-1

# Build-time source for the gitignored INT8 student model when it is not present
# in the Docker build context (must be the released v2.0.0 ONNX binary).
STUDENT_MODEL_URL=http://rustfs:9000/phishguard-artifacts/models/v2.0.0/student_model.onnx

GATEWAY_DOMAIN=phishguard-gateway-dev-1.example.com
BACKEND_URL=https://${GATEWAY_DOMAIN}
