# ---------------------------------------------------------------------------
# PhishGuard-Multimodal — Local Development Environment Template
#
# Use this configuration with `docker-compose.local.yml` for fully self-contained
# local development with all dependencies (PostgreSQL, Redis, RustFS, Gateway).
#
# Copy to `.env`:
#   cp .env.local.example .env
#
# Start stack:
#   docker compose -f docker-compose.local.yml up -d --build
# ---------------------------------------------------------------------------

ENV_NAME=dev-1
COMPOSE_PROJECT_NAME=phishguard-local
GATEWAY_PORT=8010

ENVIRONMENT=development
AUTH_DEV_MODE=true
STATIC_DIR=/app/apps/backend/static

# --- PostgreSQL Datastore (local container) ---
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=dev_postgres_password_123!
POSTGRES_DB=phishguard_dev_1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://phishguard:dev_postgres_password_123!@postgres:5432/phishguard_dev_1

# --- Redis Cache & Rate Limit (local container) ---
REDIS_PASSWORD=dev_redis_password_123!
REDIS_PORT=6379
REDIS_URL=redis://:dev_redis_password_123!@redis:6379/0

# --- RustFS Artifact Storage (local container) ---
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ENDPOINT_URL=http://rustfs:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=phishguard-artifacts-dev-1
RUSTFS_REGION=us-east-1

# Build-time source for the gitignored INT8 student model when absent from the
# Docker build context (released v2.0.0 ONNX). Upload it to the local RustFS
# bucket first, or place it at apps/extension/public/models/student_model.onnx.
STUDENT_MODEL_URL=

GATEWAY_DOMAIN=localhost:8010
BACKEND_URL=http://${GATEWAY_DOMAIN}
