# ---------------------------------------------------------------------------
# Production environment
# Copy to a location Dokploy reads as `.env`, or paste into the Dokploy Compose
# service "Environment" editor. Deploys from the `main` git branch ONLY.
# ---------------------------------------------------------------------------

# --- Environment identity (drives project/volume/container namespacing) -----
ENV_NAME=prod
COMPOSE_PROJECT_NAME=phishguard-prod
GATEWAY_PORT=8000

# --- Gateway ---------------------------------------------------------------
ENVIRONMENT=production
# MUST be false in prod. Requires auth.py to actually honor this (see
# deploy/DEPLOY_DOKPLOY.md §6 — currently a POC stub).
AUTH_DEV_MODE=false
STATIC_DIR=/app/apps/backend/static

# --- Datastores (Dokploy-managed, on dokploy-network) ----------------------
# Postgres: user=phishguard db=phishguard host=phishguard-db-tpalba port=5432
# Bare `postgresql://` (NOT +psycopg); db/database.py rewrites it to +asyncpg.
DATABASE_URL=postgresql://phishguard:CHANGE_ME_PROD_PG@phishguard-db-tpalba:5432/phishguard
# Redis host=phishguard-redis-pto1ma port=6379
REDIS_URL=redis://:CHANGE_ME_PROD_REDIS@phishguard-redis-pto1ma:6379/0

# --- Artifact Storage (RustFS S3-compatible, external host) -----------------
RUSTFS_ENDPOINT_URL=http://rustfs:9000
RUSTFS_ACCESS_KEY=CHANGE_ME_PROD_RUSTFS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_PROD_RUSTFS_SECRET
RUSTFS_BUCKET=phishguard-artifacts
RUSTFS_REGION=us-east-1
# Build-time source for the gitignored INT8 student model when it is not present
# in the Docker build context (must be the released v2.0.0 ONNX binary).
STUDENT_MODEL_URL=http://rustfs:9000/phishguard-artifacts/models/v2.0.0/student_model.onnx

# --- Gateway Domain & URL (single source of truth for Dokploy domains & frontend builds)
GATEWAY_DOMAIN=phishguard-gateway-prod-CHANGE_ME_PROJECT_NUMBER.asia-south1.run.app
BACKEND_URL=https://${GATEWAY_DOMAIN}
# Build-time SECRET for both builds (compose `secrets:`, Dokploy "Build-time Secrets" / Cloud Build Secret Manager): base64 of the CRX signing PEM.
# Generate/export it with scripts/extension_key.py export-env (see README "Extension signing key").
EXTENSION_SIGNING_KEY_B64=CHANGE_ME_EXTENSION_SIGNING_KEY_B64

# --- Dataset Agent (dormant compose profile `dataset-agent`; one-shot batch) --
# Manual run: docker compose --profile dataset-agent run --rm dataset-agent
DATASET_AGENT_OUTPUT_DIR=/app/data/daily_datasets
DATASET_AGENT_LIFECYCLE_DIR=/app/data/phishguard_daily_aggregated
DATASET_AGENT_SEARCH_PROVIDER=auto
DATASET_AGENT_SAMPLE_TARGET=100
DATASET_AGENT_EXPORT_LIFECYCLE=true
DATASET_AGENT_FEED_SOURCES=openphish,tranco
DATASET_AGENT_TRANCO_TOP_N=10000
DATASET_AGENT_FETCH_FEED_PAGES=false
DATASET_AGENT_FETCH_CONCURRENCY=8
# Gemini Deep Research stage (costs money per task; keep disabled unless needed)
DATASET_AGENT_DEEP_RESEARCH_ENABLED=false
DATASET_AGENT_DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
DATASET_AGENT_DEEP_RESEARCH_TASKS=1
DATASET_AGENT_DEEP_RESEARCH_TIMEOUT_SECONDS=1800
DATASET_AGENT_DEEP_RESEARCH_MAX_URLS=50
DATASET_AGENT_EXTRACTION_MODEL=gemini-3.6-flash
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
# Gemini ADK cloud teacher for the gateway's /v1/escalate/gemini + playground (GEMINI_API_KEY above is shared; placeholder = unconfigured)
GEMINI_TEACHER_ENABLED=true
GEMINI_TEACHER_MODEL=gemini-3.5-flash-lite
GEMINI_TEACHER_TIMEOUT_S=8
GEMINI_TEACHER_MAX_CALLS_PER_HOUR=200
# Optional Vertex AI mode (instead of an API key)
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
