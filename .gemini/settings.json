{
  "$schema": "https://antigravity.google/schemas/settings.json",
  "permissions": {
    "allow": [
      "command(git status*)",
      "command(git log*)",
      "command(git diff*)",
      "command(git branch*)",
      "command(git rev-parse*)",
      "command(git show*)",
      "command(git ls-remote*)"
    ],
    "ask": [
      "command(git *)",
      "command(git)"
    ]
  }
}
